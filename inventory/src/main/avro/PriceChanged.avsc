            "type": "string"
        },
        {
            "name": "price",
            "type": "double"
        },
        {
            "name": "stock",
            "type": "int"
        },
        {
            "name": "timestamp",
            "type": {
                "type": "long",
                "logicalType": "timestamp-millis"
            }
        }
    ]
}
