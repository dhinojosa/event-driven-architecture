{
    "name": "inventory-outbox-connector",
    "config": {
        "connector.class": "io.confluent.connect.jdbc.JdbcSourceConnector",
        "connection.url": "jdbc:postgresql://postgres-inventory:5432/inventorydb",
        "connection.user": "postgres",
        "connection.password": "postgres",
        "topic.prefix": "",
        "transforms": "extractKey,regexRouter",
        "transforms.extractKey.type": "org.apache.kafka.connect.transforms.ValueToKey",
        "transforms.extractKey.fields": "aggregate_id",
        "transforms.regexRouter.type": "org.apache.kafka.connect.transforms.RegexRouter",
        "transforms.regexRouter.regex": ".*",
        "transforms.regexRouter.replacement": "inventory-test",
        "mode": "incrementing",
        "incrementing.column.name": "id",
        "table.whitelist": "public.product_outbox",
        "key.converter": "io.confluent.connect.avro.AvroConverter",
        "key.converter.schema.registry.url": "http://schema-registry:8081",
        "value.converter": "io.confluent.connect.avro.AvroConverter",
        "value.converter.schema.registry.url": "http://schema-registry:8081",
        "key.converter.schema.naming.strategy": "io.confluent.kafka.serializers.subject.TopicNameStrategy",
        "value.converter.schema.naming.strategy": "io.confluent.kafka.serializers.subject.TopicNameStrategy",
        "poll.interval.ms": 1000,
        "batch.max.rows": 100,
        "table.types": "TABLE"
    }
}
