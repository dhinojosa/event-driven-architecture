{
    "name": "jdbc-sink-order-history",
    "config": {
        "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
        "tasks.max": "1",
        "topics": "ORDER_HISTORY",
        "connection.url": "jdbc:postgresql://postgres-customer:5432/customerdb",
        "connection.user": "postgres",
        "connection.password": "postgres",
        "auto.create": "false",
        "insert.mode": "upsert",
        "pk.mode": "record_key",
        "pk.fields": "orderid",
        "table.name.format": "orderhistory",
        "transforms": "TimestampConverter,LowerCaseFields",
        "transforms.TimestampConverter.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
        "transforms.TimestampConverter.target.type": "Timestamp",
        "transforms.TimestampConverter.field": "TIMESTAMP",
        "transforms.LowerCaseFields.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
        "transforms.LowerCaseFields.renames": "ORDERID:orderid,CUSTOMERID:customerid,TIMESTAMP:timestamp,TOTAL:total"
    }
}
